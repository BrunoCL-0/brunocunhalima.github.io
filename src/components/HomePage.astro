---
import { profile } from "@content/profile";
import { projects } from "@content/projects";
import { publications } from "@content/publications";
import { experiences, extracurriculars } from "@content/experience";
import { skillGroups } from "@content/skills";
import ContactLinks from "@components/ContactLinks.astro";
import brunoPhoto from "../assets/bruno-portrait.png";
import indexPhoto from "../assets/bruno-robotics.jpeg";
import siintecIotPhoto from "../assets/siintec-iot-presentation.jpeg";
import siintecTurtlePhoto from "../assets/siintec-turtle-presentation.png";
import turtlebotPhoto from "../assets/turtlebot2i-retrofit.jpeg";
import gazeboTurtlebotPhoto from "../assets/gazebo-turtlebot-sensors.png";
import agvConceptPhoto from "../assets/agv-manipulation-concept.png";
import nav2PhysicalVideo from "../assets/nav2-physical-demo.mp4";
import nav2Video from "../assets/nav2-navigation-demo.mp4";
import yoloVideo from "../assets/yolo-detection-demo.webm";
import type { Language } from "@i18n/config";
import { withBase } from "@utils/paths";

type Props = {
  language: Language;
};

const { language } = Astro.props;
type ProjectMediaItem =
  | {
      type: "image";
      src: string;
      alt: string;
    }
  | {
      type: "video";
      src: string;
      label: string;
    };

function isProjectMediaItem(item: ProjectMediaItem | undefined): item is ProjectMediaItem {
  return Boolean(item);
}

const copy = {
  pt: {
    seeProjects: "Ver projetos",
    seeResearch: "Ver publicações",
    current: "Atual",
    featuredProjects: "Projetos em destaque",
    projectIntro:
      "Estudos de caso pensados para mostrar contexto, decisões técnicas e aprendizado, não apenas uma lista de tecnologias.",
    media: "Participações em eventos",
    mediaIntro:
      "Registros pontuais de apresentações, demonstrações técnicas e contato com projetos em eventos.",
    indexCaption:
      "Participação no INDEX Bahia representando o SENAI CIMATEC, com demonstração integrando o robô colaborativo FAIRINO FR5 e a plataforma quadrúpede Unitree B1. Atuei no algoritmo de controle do manipulador e na coordenação das trajetórias.",
    siintecTurtleCaption:
      "Apresentação no SIINTEC do trabalho sobre retrofit do TurtleBot2i para ROS 2.",
    siintecIotCaption:
      "Apresentação no SIINTEC do trabalho sobre sistema de medição elétrica residencial com IoT e automação.",
    experience: "Experiência profissional",
    extracurricular: "Pesquisa voluntária e equipes",
    publications: "Publicações",
    publicationIntro:
      "Trabalhos acadêmicos relacionados a robótica, IoT, automação e modelagem aplicada.",
    skills: "Competências técnicas",
    skillsIntro:
      "Sem barras de porcentagem: as tecnologias aparecem agrupadas pelo tipo de problema em que foram usadas.",
    education: "Formação",
    contact: "Contato",
    contactIntro:
      "Canais públicos confirmados para contato profissional, projetos e pesquisa.",
    focusAreasLabel: "Áreas de foco",
    projectCta: "Ver estudo de caso",
    caseStudy: "Estudo de caso",
    role: "Contribuição"
  },
  en: {
    seeProjects: "See projects",
    seeResearch: "See publications",
    current: "Current",
    featuredProjects: "Featured projects",
    projectIntro:
      "Case studies designed to show context, technical decisions, and learning instead of only listing technologies.",
    media: "Event participation",
    mediaIntro:
      "Selected records from presentations, technical demonstrations, and project showcases.",
    indexCaption:
      "Participation at INDEX Bahia representing SENAI CIMATEC, with a demonstration integrating the FAIRINO FR5 collaborative robot and the Unitree B1 quadruped platform. I worked on the manipulator control algorithm and trajectory coordination.",
    siintecTurtleCaption:
      "SIINTEC presentation of the work on the TurtleBot2i retrofit for ROS 2.",
    siintecIotCaption:
      "SIINTEC presentation of the work on a residential electrical measurement system with IoT and automation.",
    experience: "Experience",
    extracurricular: "Volunteer research and teams",
    publications: "Publications",
    publicationIntro:
      "Academic work related to robotics, IoT, automation, and applied modeling.",
    skills: "Technical skills",
    skillsIntro:
      "No arbitrary percentage bars: technologies are grouped by the type of problem where they were used.",
    education: "Education",
    contact: "Contact",
    contactIntro:
      "Confirmed public channels for professional contact, projects, and research.",
    focusAreasLabel: "Focus areas",
    projectCta: "View case study",
    caseStudy: "Case study",
    role: "Contribution"
  }
} as const;

const t = copy[language];
const hero = profile.hero[language];
const projectImages = {
  "turtlebot2i-retrofit.jpeg": turtlebotPhoto.src,
  "gazebo-turtlebot-sensors.png": gazeboTurtlebotPhoto.src,
  "agv-manipulation-concept.png": agvConceptPhoto.src
} as const;
const projectVideos = {
  "nav2-physical-demo.mp4": nav2PhysicalVideo,
  "nav2-navigation-demo.mp4": nav2Video,
  "yolo-detection-demo.webm": yoloVideo
} as const;
---

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1>{hero.title}</h1>
    <p class="hero-summary">{hero.summary}</p>
    <div class="hero-actions">
      <a class="button primary" href="#projects">{t.seeProjects}</a>
    </div>
    <ul class="focus-list hero-focus" aria-label={t.focusAreasLabel}>
      {profile.focusAreas.map((area) => <li>{area[language]}</li>)}
    </ul>
  </div>
  <aside class="hero-photo-card" aria-label="Bruno Cunha Lima em ambiente de robótica">
    <img src={brunoPhoto.src} alt="Retrato de Bruno Cunha Lima" />
  </aside>
</section>

<section class="section" id="projects">
  <div class="section-heading">
    <h2>{t.featuredProjects}</h2>
    <p>{t.projectIntro}</p>
  </div>
  <div class="project-grid">
    {
      projects.map((project) => {
        const mediaCandidates = [
          project.image
            ? {
                type: "image" as const,
                src: projectImages[project.image as keyof typeof projectImages],
                alt: project.imageAlt[language]
              }
            : undefined,
          project.video
            ? {
                type: "video" as const,
                src: projectVideos[project.video as keyof typeof projectVideos],
                label: project.videoLabel[language]
              }
            : undefined,
          ...(project.extraVideos?.map((item) => ({
            type: "video" as const,
            src: projectVideos[item.video as keyof typeof projectVideos],
            label: item.videoLabel[language]
          })) ?? [])
        ];
        const media = mediaCandidates.filter(isProjectMediaItem) as ProjectMediaItem[];

        return (
          <article class="project-card">
            <div class="project-media" data-carousel>
              {media.length > 0 ? (
                media.map((item, index) => (
                  <figure class="media-slide" data-media-slide hidden={index !== 0}>
                    <div class="media-frame" data-media-frame>
                      {item.type === "image" ? (
                        <img class="project-image" src={item.src} alt={item.alt} />
                      ) : (
                        <video src={item.src} controls muted playsinline preload="metadata" />
                      )}
                      {media.length > 1 && index === 0 && (
                        <div class="media-controls" data-media-controls aria-label="Project media controls">
                          <button type="button" data-media-prev aria-label="Previous media">‹</button>
                          <button type="button" data-media-next aria-label="Next media">›</button>
                        </div>
                      )}
                    </div>
                    {item.type === "video" && <figcaption>{item.label}</figcaption>}
                  </figure>
                ))
              ) : (
                <div class="project-visual" aria-hidden="true">
                  <span />
                  <span />
                  <span />
                </div>
              )}
            </div>
            <h3>{project.title[language]}</h3>
            <p>{project.summary[language]}</p>
            <p class="project-context">{project.context[language]}</p>
            <ul class="tag-list">
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <a href={withBase(`${language}/projects/${project.slug}/`)}>{t.projectCta}</a>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  document.querySelectorAll("[data-carousel]").forEach((gallery) => {
    const slides = Array.from(gallery.querySelectorAll("[data-media-slide]"));
    const controls = gallery.querySelector("[data-media-controls]");
    const previousButtons = Array.from(gallery.querySelectorAll("[data-media-prev]"));
    const nextButtons = Array.from(gallery.querySelectorAll("[data-media-next]"));
    let current = 0;

    function showSlide(index: number) {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === current;
        slide.toggleAttribute("hidden", !isActive);
        if (!isActive) slide.querySelector("video")?.pause();
      });
      const activeFrame = slides[current]?.querySelector("[data-media-frame]");
      if (controls && activeFrame) activeFrame.append(controls);
    }

    previousButtons.forEach((button) => button.addEventListener("click", () => showSlide(current - 1)));
    nextButtons.forEach((button) => button.addEventListener("click", () => showSlide(current + 1)));
  });
</script>

<section class="section" id="media">
  <div class="section-heading">
    <h2>{t.media}</h2>
    <p>{t.mediaIntro}</p>
  </div>
  <div class="media-gallery event-carousel" data-carousel>
    <figure class="media-slide media-feature" data-media-slide>
      <div class="media-frame" data-media-frame>
        <img src={indexPhoto.src} alt="Bruno Cunha Lima em demonstração de robótica no evento INDEX" />
        <div class="media-controls" data-media-controls aria-label="Event media controls">
          <button type="button" data-media-prev aria-label="Previous event photo">‹</button>
          <button type="button" data-media-next aria-label="Next event photo">›</button>
        </div>
      </div>
      <figcaption>{t.indexCaption}</figcaption>
    </figure>
    <figure class="media-slide media-feature" data-media-slide hidden>
      <div class="media-frame" data-media-frame>
        <img src={siintecTurtlePhoto.src} alt="Bruno Cunha Lima em apresentação de pôster no SIINTEC sobre retrofit do TurtleBot2i para ROS 2" />
      </div>
      <figcaption>{t.siintecTurtleCaption}</figcaption>
    </figure>
    <figure class="media-slide media-feature" data-media-slide hidden>
      <div class="media-frame" data-media-frame>
        <img src={siintecIotPhoto.src} alt="Bruno Cunha Lima em apresentação de pôster no SIINTEC sobre IoT e automação" />
      </div>
      <figcaption>{t.siintecIotCaption}</figcaption>
    </figure>
  </div>
</section>

<section class="section" id="experience">
  <div class="section-heading">
    <h2>{t.experience}</h2>
  </div>
  <div class="timeline">
    {
      experiences.map((item) => (
        <article class="timeline-item">
          <p class="timeline-period">{item.period[language]}</p>
          <div>
            <p class="eyebrow">{item.kind[language]}</p>
            <h3>{item.role[language]}</h3>
            <p class="meta">
              {item.organization} · {item.location[language]}
            </p>
            <ul>
              {item.highlights[language].map((highlight) => <li>{highlight}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="section">
  <div class="section-heading">
    <h2>{t.extracurricular}</h2>
  </div>
  <div class="timeline compact">
    {
      extracurriculars.map((item) => (
        <article class="timeline-item">
          <p class="timeline-period">{item.period[language]}</p>
          <div>
            <p class="eyebrow">{item.kind[language]}</p>
            <h3>{item.role[language]}</h3>
            <p class="meta">
              {item.organization} · {item.location[language]}
            </p>
            <ul>
              {item.highlights[language].map((highlight) => <li>{highlight}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="section" id="skills">
  <div class="section-heading">
    <h2>{t.skills}</h2>
    <p>{t.skillsIntro}</p>
  </div>
  <div class="skill-grid">
    {
      skillGroups.map((group) => (
        <article class="skill-card">
          <h3>{group.title[language]}</h3>
          <ul class="tag-list">
            {group.items.map((item) => <li>{typeof item === "string" ? item : item[language]}</li>)}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<section class="section" id="publications">
  <div class="section-heading">
    <h2>{t.publications}</h2>
    <p>{t.publicationIntro}</p>
  </div>
  <div class="publication-list">
    {
      publications.map((publication) => (
        <article>
          <h3>{publication.title[language]}</h3>
          <p>{publication.venue[language]}</p>
          {publication.status && <p>{publication.status[language]}</p>}
          {publication.href && <a href={publication.href}>Link</a>}
        </article>
      ))
    }
  </div>
</section>

<section class="section" id="education">
  <div class="section-heading">
    <h2>{t.education}</h2>
  </div>
  <p>{profile.education[language]}</p>
</section>

<section class="section" id="contact">
  <div class="section-heading">
    <h2>{t.contact}</h2>
    <p>{t.contactIntro}</p>
  </div>
  <ContactLinks />
</section>
