---
import { profile } from "@content/profile";
import { projects } from "@content/projects";
import { publications } from "@content/publications";
import { experiences, extracurriculars } from "@content/experience";
import { skillGroups } from "@content/skills";
import brunoPhoto from "../assets/bruno-robotics.jpeg";
import type { Language } from "@i18n/config";
import { withBase } from "@utils/paths";

type Props = {
  language: Language;
};

const { language } = Astro.props;

const copy = {
  pt: {
    enterPortfolio: "Ver portfólio",
    seeProjects: "Ver projetos",
    seeExperience: "Ver experiência",
    seeResearch: "Ver publicações",
    exploreTitle: "Escolha o que explorar",
    exploreText:
      "Se quiser ir direto ao ponto, comece pelos projetos. Eles contam melhor como engenharia elétrica, software e robótica se conectam no meu trabalho.",
    current: "Atual",
    featuredProjects: "Projetos em destaque",
    projectIntro:
      "Estudos de caso pensados para mostrar contexto, decisões técnicas e aprendizado, não apenas uma lista de tecnologias.",
    experience: "Experiência profissional",
    extracurricular: "Pesquisa voluntária e equipes",
    publications: "Publicações",
    publicationIntro:
      "Trabalhos acadêmicos relacionados a robótica, IoT, automação e modelagem aplicada.",
    skills: "Competências técnicas",
    skillsIntro:
      "Sem barras de porcentagem: as tecnologias aparecem agrupadas pelo tipo de problema em que foram usadas.",
    education: "Formação",
    contact: "Contato",
    contactTodo:
      "Links públicos pendentes de confirmação. Por padrão, endereço, telefone, data e local de nascimento não serão publicados.",
    projectCta: "Ver estudo de caso",
    caseStudy: "Estudo de caso",
    role: "Contribuição",
    status: {
      featured: "Destaque",
      draft: "Em revisão"
    }
  },
  en: {
    enterPortfolio: "View portfolio",
    seeProjects: "See projects",
    seeExperience: "See experience",
    seeResearch: "See publications",
    exploreTitle: "Choose what to explore",
    exploreText:
      "If you want the shortest path, start with the projects. They best show how electrical engineering, software, and robotics connect in my work.",
    current: "Current",
    featuredProjects: "Featured projects",
    projectIntro:
      "Case studies designed to show context, technical decisions, and learning instead of only listing technologies.",
    experience: "Experience",
    extracurricular: "Volunteer research and teams",
    publications: "Publications",
    publicationIntro:
      "Academic work related to robotics, IoT, automation, and applied modeling.",
    skills: "Technical skills",
    skillsIntro:
      "No arbitrary percentage bars: technologies are grouped by the type of problem where they were used.",
    education: "Education",
    contact: "Contact",
    contactTodo:
      "Public links pending confirmation. By default, address, phone number, date of birth, and place of birth will not be published.",
    projectCta: "View case study",
    caseStudy: "Case study",
    role: "Contribution",
    status: {
      featured: "Featured",
      draft: "Under review"
    }
  }
} as const;

const t = copy[language];
const hero = profile.hero[language];
---

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1>{hero.title}</h1>
    <p class="hero-summary">{hero.summary}</p>
    <p class="hero-note">{hero.availability}</p>
    <div class="hero-actions">
      <a class="button primary" href="#portfolio">{t.enterPortfolio}</a>
      <a class="button secondary" href="#projects">{t.seeProjects}</a>
    </div>
  </div>
  <aside class="hero-photo-card" aria-label="Bruno Cunha Lima em ambiente de robótica">
    <img src={brunoPhoto.src} alt="Bruno Cunha Lima trabalhando em uma demonstração de robótica no SENAI CIMATEC" />
    <ul class="focus-list" aria-label="Focus areas">
      {profile.focusAreas.map((area) => <li>{area}</li>)}
    </ul>
  </aside>
</section>

<section class="section explore-section" id="portfolio">
  <div class="section-heading">
    <h2>{t.exploreTitle}</h2>
    <p>{t.exploreText}</p>
  </div>
  <div class="explore-grid">
    <a href="#projects">{t.seeProjects}</a>
    <a href="#experience">{t.seeExperience}</a>
    <a href="#publications">{t.seeResearch}</a>
    <a href="#skills">{t.skills}</a>
  </div>
</section>

<section class="section" id="projects">
  <div class="section-heading">
    <h2>{t.featuredProjects}</h2>
    <p>{t.projectIntro}</p>
  </div>
  <div class="project-grid">
    {
      projects.map((project) => (
        <article class="project-card">
          <div class="project-visual" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <p class="project-status">{t.status[project.status]}</p>
          <h3>{project.title[language]}</h3>
          <p>{project.summary[language]}</p>
          <p class="project-context">{project.context[language]}</p>
          <ul class="tag-list">
            {project.tags.map((tag) => <li>{tag}</li>)}
          </ul>
          <a href={withBase(`${language}/projects/${project.slug}/`)}>{t.projectCta}</a>
        </article>
      ))
    }
  </div>
</section>

<section class="section" id="experience">
  <div class="section-heading">
    <h2>{t.experience}</h2>
  </div>
  <div class="timeline">
    {
      experiences.map((item) => (
        <article class="timeline-item">
          <p class="timeline-period">{item.period[language]}</p>
          <div>
            <p class="eyebrow">{item.kind[language]}</p>
            <h3>{item.role[language]}</h3>
            <p class="meta">
              {item.organization} · {item.location[language]}
            </p>
            <ul>
              {item.highlights[language].map((highlight) => <li>{highlight}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="section">
  <div class="section-heading">
    <h2>{t.extracurricular}</h2>
  </div>
  <div class="timeline compact">
    {
      extracurriculars.map((item) => (
        <article class="timeline-item">
          <p class="timeline-period">{item.period[language]}</p>
          <div>
            <p class="eyebrow">{item.kind[language]}</p>
            <h3>{item.role[language]}</h3>
            <p class="meta">
              {item.organization} · {item.location[language]}
            </p>
            <ul>
              {item.highlights[language].map((highlight) => <li>{highlight}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="section" id="skills">
  <div class="section-heading">
    <h2>{t.skills}</h2>
    <p>{t.skillsIntro}</p>
  </div>
  <div class="skill-grid">
    {
      skillGroups.map((group) => (
        <article class="skill-card">
          <h3>{group.title[language]}</h3>
          <ul class="tag-list">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<section class="section" id="publications">
  <div class="section-heading">
    <h2>{t.publications}</h2>
    <p>{t.publicationIntro}</p>
  </div>
  <div class="publication-list">
    {
      publications.map((publication) => (
        <article>
          <h3>{publication.title[language]}</h3>
          <p>{publication.venue[language]}</p>
          {publication.status && <p>{publication.status[language]}</p>}
          {publication.href && <a href={publication.href}>Link</a>}
        </article>
      ))
    }
  </div>
</section>

<section class="section" id="education">
  <div class="section-heading">
    <h2>{t.education}</h2>
  </div>
  <p>{profile.education[language]}</p>
</section>

<section class="section" id="contact">
  <div class="section-heading">
    <h2>{t.contact}</h2>
  </div>
  <p>{t.contactTodo}</p>
</section>
