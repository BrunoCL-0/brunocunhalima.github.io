---
import { profile } from "@content/profile";
import { projects } from "@content/projects";
import { publications } from "@content/publications";
import { experiences, extracurriculars } from "@content/experience";
import { skillGroups } from "@content/skills";
import brunoPhoto from "../assets/bruno-portrait.png";
import indexPhoto from "../assets/bruno-robotics.jpeg";
import turtlebotPhoto from "../assets/turtlebot2i-retrofit.jpeg";
import agvConceptPhoto from "../assets/agv-manipulation-concept.png";
import type { Language } from "@i18n/config";
import { withBase } from "@utils/paths";

type Props = {
  language: Language;
};

const { language } = Astro.props;

const copy = {
  pt: {
    seeProjects: "Ver projetos",
    seeResearch: "Ver publicações",
    current: "Atual",
    featuredProjects: "Projetos em destaque",
    projectIntro:
      "Estudos de caso pensados para mostrar contexto, decisões técnicas e aprendizado, não apenas uma lista de tecnologias.",
    media: "Participações em eventos",
    mediaIntro:
      "Registros pontuais de apresentações, demonstrações técnicas e contato com projetos em eventos.",
    indexCaption:
      "Participação no evento INDEX com demonstração de robótica e manipulação móvel no SENAI CIMATEC.",
    experience: "Experiência profissional",
    extracurricular: "Pesquisa voluntária e equipes",
    publications: "Publicações",
    publicationIntro:
      "Trabalhos acadêmicos relacionados a robótica, IoT, automação e modelagem aplicada.",
    skills: "Competências técnicas",
    skillsIntro:
      "Sem barras de porcentagem: as tecnologias aparecem agrupadas pelo tipo de problema em que foram usadas.",
    education: "Formação",
    contact: "Contato",
    contactIntro:
      "Canais públicos confirmados para contato profissional, projetos e pesquisa.",
    projectCta: "Ver estudo de caso",
    caseStudy: "Estudo de caso",
    role: "Contribuição",
    status: {
      featured: "Destaque",
      draft: "Em revisão"
    }
  },
  en: {
    seeProjects: "See projects",
    seeResearch: "See publications",
    current: "Current",
    featuredProjects: "Featured projects",
    projectIntro:
      "Case studies designed to show context, technical decisions, and learning instead of only listing technologies.",
    media: "Event participation",
    mediaIntro:
      "Selected records from presentations, technical demonstrations, and project showcases.",
    indexCaption:
      "Participation at the INDEX event with a robotics and mobile manipulation demonstration at SENAI CIMATEC.",
    experience: "Experience",
    extracurricular: "Volunteer research and teams",
    publications: "Publications",
    publicationIntro:
      "Academic work related to robotics, IoT, automation, and applied modeling.",
    skills: "Technical skills",
    skillsIntro:
      "No arbitrary percentage bars: technologies are grouped by the type of problem where they were used.",
    education: "Education",
    contact: "Contact",
    contactIntro:
      "Confirmed public channels for professional contact, projects, and research.",
    projectCta: "View case study",
    caseStudy: "Case study",
    role: "Contribution",
    status: {
      featured: "Featured",
      draft: "Under review"
    }
  }
} as const;

const t = copy[language];
const hero = profile.hero[language];
const projectImages = {
  "turtlebot2i-retrofit.jpeg": turtlebotPhoto.src,
  "agv-manipulation-concept.png": agvConceptPhoto.src
} as const;
const contacts = [
  {
    label: "Email",
    value: "cunhalimabruno@gmail.com",
    href: "mailto:cunhalimabruno@gmail.com",
    icon: "mail"
  },
  {
    label: "LinkedIn",
    value: "bruno-cunha-lima",
    href: "https://www.linkedin.com/in/bruno-cunha-lima-04756030a/",
    icon: "linkedin"
  },
  {
    label: "GitHub",
    value: "BrunoCL-0",
    href: "https://github.com/BrunoCL-0",
    icon: "github"
  }
] as const;
---

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1>{hero.title}</h1>
    <p class="hero-summary">{hero.summary}</p>
    <p class="hero-note">{hero.availability}</p>
    <div class="hero-actions">
      <a class="button primary" href="#projects">{t.seeProjects}</a>
    </div>
    <ul class="focus-list hero-focus" aria-label="Focus areas">
      {profile.focusAreas.map((area) => <li>{area}</li>)}
    </ul>
  </div>
  <aside class="hero-photo-card" aria-label="Bruno Cunha Lima em ambiente de robótica">
    <img src={brunoPhoto.src} alt="Retrato de Bruno Cunha Lima" />
  </aside>
</section>

<section class="section" id="projects">
  <div class="section-heading">
    <h2>{t.featuredProjects}</h2>
    <p>{t.projectIntro}</p>
  </div>
  <div class="project-grid">
    {
      projects.map((project) => (
        <article class="project-card">
          {
            project.image ? (
              <img
                class="project-image"
                src={projectImages[project.image as keyof typeof projectImages]}
                alt={project.imageAlt[language]}
              />
            ) : (
              <div class="project-visual" aria-hidden="true">
                <span />
                <span />
                <span />
              </div>
            )
          }
          <p class="project-status">{t.status[project.status]}</p>
          <h3>{project.title[language]}</h3>
          <p>{project.summary[language]}</p>
          <p class="project-context">{project.context[language]}</p>
          <ul class="tag-list">
            {project.tags.map((tag) => <li>{tag}</li>)}
          </ul>
          <a href={withBase(`${language}/projects/${project.slug}/`)}>{t.projectCta}</a>
        </article>
      ))
    }
  </div>
</section>

<section class="section" id="media">
  <div class="section-heading">
    <h2>{t.media}</h2>
    <p>{t.mediaIntro}</p>
  </div>
  <figure class="media-feature">
    <img src={indexPhoto.src} alt="Bruno Cunha Lima em demonstração de robótica no evento INDEX" />
    <figcaption>{t.indexCaption}</figcaption>
  </figure>
</section>

<section class="section" id="experience">
  <div class="section-heading">
    <h2>{t.experience}</h2>
  </div>
  <div class="timeline">
    {
      experiences.map((item) => (
        <article class="timeline-item">
          <p class="timeline-period">{item.period[language]}</p>
          <div>
            <p class="eyebrow">{item.kind[language]}</p>
            <h3>{item.role[language]}</h3>
            <p class="meta">
              {item.organization} · {item.location[language]}
            </p>
            <ul>
              {item.highlights[language].map((highlight) => <li>{highlight}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="section">
  <div class="section-heading">
    <h2>{t.extracurricular}</h2>
  </div>
  <div class="timeline compact">
    {
      extracurriculars.map((item) => (
        <article class="timeline-item">
          <p class="timeline-period">{item.period[language]}</p>
          <div>
            <p class="eyebrow">{item.kind[language]}</p>
            <h3>{item.role[language]}</h3>
            <p class="meta">
              {item.organization} · {item.location[language]}
            </p>
            <ul>
              {item.highlights[language].map((highlight) => <li>{highlight}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="section" id="skills">
  <div class="section-heading">
    <h2>{t.skills}</h2>
    <p>{t.skillsIntro}</p>
  </div>
  <div class="skill-grid">
    {
      skillGroups.map((group) => (
        <article class="skill-card">
          <h3>{group.title[language]}</h3>
          <ul class="tag-list">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<section class="section" id="publications">
  <div class="section-heading">
    <h2>{t.publications}</h2>
    <p>{t.publicationIntro}</p>
  </div>
  <div class="publication-list">
    {
      publications.map((publication) => (
        <article>
          <h3>{publication.title[language]}</h3>
          <p>{publication.venue[language]}</p>
          {publication.status && <p>{publication.status[language]}</p>}
          {publication.href && <a href={publication.href}>Link</a>}
        </article>
      ))
    }
  </div>
</section>

<section class="section" id="education">
  <div class="section-heading">
    <h2>{t.education}</h2>
  </div>
  <p>{profile.education[language]}</p>
</section>

<section class="section" id="contact">
  <div class="section-heading">
    <h2>{t.contact}</h2>
    <p>{t.contactIntro}</p>
  </div>
  <div class="contact-grid">
    {
      contacts.map((contact) => (
        <a class="contact-card" href={contact.href}>
          <span class="contact-icon" aria-hidden="true">
            {
              contact.icon === "mail" && (
                <svg viewBox="0 0 24 24" role="img">
                  <path d="M4 6h16v12H4z" />
                  <path d="m4 7 8 6 8-6" />
                </svg>
              )
            }
            {
              contact.icon === "linkedin" && (
                <svg viewBox="0 0 24 24" role="img">
                  <path d="M6.5 10v8" />
                  <path d="M6.5 6v.01" />
                  <path d="M11 18v-8" />
                  <path d="M11 13.5c0-2.1 1.25-3.5 3.25-3.5S18 11.35 18 14v4" />
                </svg>
              )
            }
            {
              contact.icon === "github" && (
                <svg viewBox="0 0 24 24" role="img">
                  <path d="M12 3.5a8.5 8.5 0 0 0-2.7 16.56c.43.08.58-.18.58-.41v-1.44c-2.39.52-2.89-1.03-2.89-1.03-.39-.99-.96-1.25-.96-1.25-.79-.54.06-.53.06-.53.87.06 1.33.9 1.33.9.77 1.32 2.03.94 2.52.72.08-.56.3-.94.55-1.16-1.91-.22-3.92-.96-3.92-4.25 0-.94.34-1.71.9-2.31-.09-.22-.39-1.1.08-2.28 0 0 .73-.23 2.4.88A8.3 8.3 0 0 1 12 8.13c.7 0 1.4.09 2.06.27 1.66-1.11 2.39-.88 2.39-.88.47 1.18.17 2.06.08 2.28.56.6.9 1.37.9 2.31 0 3.3-2.01 4.03-3.93 4.24.31.27.59.8.59 1.61v1.69c0 .23.15.49.59.41A8.5 8.5 0 0 0 12 3.5Z" />
                </svg>
              )
            }
          </span>
          <span>
            <strong>{contact.label}</strong>
            <span>{contact.value}</span>
          </span>
        </a>
      ))
    }
  </div>
</section>
