---
import BaseLayout from "@layouts/BaseLayout.astro";
import { projects } from "@content/projects";
import { withBase } from "@utils/paths";
import turtlebotPhoto from "../../../assets/turtlebot2i-retrofit.jpeg";
import gazeboTurtlebotPhoto from "../../../assets/gazebo-turtlebot-sensors.png";
import agvConceptPhoto from "../../../assets/agv-manipulation-concept.png";
import softClimberStepPhoto from "../../../assets/soft-climber-cycle-step6.png";
import softClimberCyclePhoto from "../../../assets/soft-climber-locomotion-cycle.png";
import softClimberActuationPhoto from "../../../assets/soft-climber-arm-actuation.png";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const projectImages = {
  "turtlebot2i-retrofit.jpeg": turtlebotPhoto.src,
  "gazebo-turtlebot-sensors.png": gazeboTurtlebotPhoto.src,
  "agv-manipulation-concept.png": agvConceptPhoto.src,
  "soft-climber-cycle-step6.png": softClimberStepPhoto.src,
  "soft-climber-locomotion-cycle.png": softClimberCyclePhoto.src,
  "soft-climber-arm-actuation.png": softClimberActuationPhoto.src
} as const;
const detailImages = [
  project.image
    ? {
        src: projectImages[project.image as keyof typeof projectImages],
        alt: project.imageAlt.en,
        label: project.imageLabel.en
      }
    : undefined,
  ...(project.extraImages?.map((item) => ({
    src: projectImages[item.image as keyof typeof projectImages],
    alt: item.imageAlt.en,
    label: item.imageLabel.en
  })) ?? [])
].filter(Boolean) as { src: string; alt: string; label: string }[];
---

<BaseLayout title={`${project.title.en} | Bruno Cunha Lima`} description={project.summary.en} language="en">
  <article class="section project-detail">
    <a href={withBase("en/#projects")}>Back</a>
    <p class="eyebrow">Case study</p>
    <h1>{project.title.en}</h1>
    <p>{project.summary.en}</p>
    {detailImages.length > 0 && (
      <div class="project-detail-media">
        {detailImages.map((item) => (
          <figure>
            <img src={item.src} alt={item.alt} />
            <figcaption>{item.label}</figcaption>
          </figure>
        ))}
      </div>
    )}
    <section>
      <h2>Context</h2>
      <p>{project.context.en}</p>
    </section>
    <section>
      <h2>My contribution</h2>
      <ul>
        {project.contribution.en.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    {project.detailSections?.map((section) => (
      <section>
        <h2>{section.title.en}</h2>
        {section.body.en.map((paragraph) => <p>{paragraph}</p>)}
      </section>
    ))}
  </article>
</BaseLayout>
