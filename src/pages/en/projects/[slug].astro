---
import BaseLayout from "@layouts/BaseLayout.astro";
import { projects } from "@content/projects";
import { withBase } from "@utils/paths";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.title.en} | Bruno Cunha Lima`} description={project.summary.en} language="en">
  <article class="section project-detail">
    <a href={withBase("en/#projects")}>Back</a>
    <p class="eyebrow">Case study</p>
    <h1>{project.title.en}</h1>
    <p>{project.summary.en}</p>
    <section>
      <h2>Context</h2>
      <p>{project.context.en}</p>
    </section>
    <section>
      <h2>My contribution</h2>
      <ul>
        {project.contribution.en.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </article>
</BaseLayout>
