---
import { withBase } from "@utils/paths";
import ContactLinks from "@components/ContactLinks.astro";
import brunoPhoto from "../assets/bruno-portrait.png";
import "@styles/global.css";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Bruno Cunha Lima</title>
  </head>
  <body>
    <main class="entry-page">
      <section class="entry-card">
        <div class="entry-copy">
          <p class="eyebrow">Electrical Engineering + Robotics + Software</p>
          <h1>Bruno Cunha Lima</h1>
          <p>
            Personal portfolio with projects, research, publications, and hands-on work in robotics,
            ROS 2, autonomous systems, and electrical engineering.
          </p>
          <div class="hero-actions">
            <a class="button primary" href={withBase("en/#projects")} data-language="en">See projects</a>
            <button class="button secondary" type="button" data-entry-contact-toggle aria-controls="entry-contact" aria-expanded="false">
              Contact
            </button>
          </div>
          <div id="entry-contact" hidden>
            <ContactLinks compact />
          </div>
        </div>
        <img src={brunoPhoto.src} alt="Portrait of Bruno Cunha Lima" />
      </section>
    </main>
    <script>
      const contactToggle = document.querySelector("[data-entry-contact-toggle]");
      const contactPanel = document.querySelector("#entry-contact");
      contactToggle?.addEventListener("click", () => {
        const isHidden = contactPanel?.hasAttribute("hidden");
        contactPanel?.toggleAttribute("hidden", !isHidden);
        contactToggle.setAttribute("aria-expanded", String(Boolean(isHidden)));
      });

      document.querySelectorAll("[data-language]").forEach((link) => {
        link.addEventListener("click", () => {
          const language = link.getAttribute("data-language");
          if (language) localStorage.setItem("preferred-language", language);
        });
      });
    </script>
  </body>
</html>
