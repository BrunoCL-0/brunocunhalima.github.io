---
import { languages } from "@i18n/config";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Bruno Cunha Lima</title>
  </head>
  <body>
    <main>
      <h1>Bruno Cunha Lima</h1>
      <p>Escolha o idioma / Choose a language</p>
      <a href={languages.pt.path} data-language="pt">Português</a>
      <a href={languages.en.path} data-language="en">English</a>
    </main>
    <script>
      const preferredLanguage = localStorage.getItem("preferred-language");
      if (preferredLanguage === "pt") window.location.replace("/pt/");
      if (preferredLanguage === "en") window.location.replace("/en/");

      document.querySelectorAll("[data-language]").forEach((link) => {
        link.addEventListener("click", () => {
          const language = link.getAttribute("data-language");
          if (language) localStorage.setItem("preferred-language", language);
        });
      });
    </script>
  </body>
</html>
