---
import { languages } from "@i18n/config";
import { withBase } from "@utils/paths";
import brunoPhoto from "../assets/bruno-robotics.jpeg";
import "@styles/global.css";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Bruno Cunha Lima</title>
  </head>
  <body>
    <main class="entry-page">
      <section class="entry-card">
        <div class="entry-copy">
          <p class="eyebrow">Electrical Engineering + Robotics + Software</p>
          <h1>Bruno Cunha Lima</h1>
          <p>
            Portfólio pessoal com projetos, pesquisa, publicações e experiência prática em robótica,
            ROS 2, sistemas autônomos e engenharia elétrica.
          </p>
          <div class="hero-actions">
            <a class="button primary" href={withBase(languages.pt.path)} data-language="pt">Português</a>
            <a class="button secondary" href={withBase(languages.en.path)} data-language="en">English</a>
          </div>
        </div>
        <img src={brunoPhoto.src} alt="Bruno Cunha Lima trabalhando em uma demonstração de robótica no SENAI CIMATEC" />
      </section>
    </main>
    <script>
      const preferredLanguage = localStorage.getItem("preferred-language");
      const base = import.meta.env.BASE_URL;
      if (preferredLanguage === "pt") window.location.replace(`${base}pt/`);
      if (preferredLanguage === "en") window.location.replace(`${base}en/`);

      document.querySelectorAll("[data-language]").forEach((link) => {
        link.addEventListener("click", () => {
          const language = link.getAttribute("data-language");
          if (language) localStorage.setItem("preferred-language", language);
        });
      });
    </script>
  </body>
</html>
