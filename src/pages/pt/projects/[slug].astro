---
import BaseLayout from "@layouts/BaseLayout.astro";
import { projects } from "@content/projects";
import { withBase } from "@utils/paths";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.title.pt} | Bruno Cunha Lima`} description={project.summary.pt} language="pt">
  <article class="section project-detail">
    <a href={withBase("pt/#projects")}>Voltar</a>
    <p class="eyebrow">Estudo de caso</p>
    <h1>{project.title.pt}</h1>
    <p>{project.summary.pt}</p>
    <section>
      <h2>Contexto</h2>
      <p>{project.context.pt}</p>
    </section>
    <section>
      <h2>Minha contribuição</h2>
      <ul>
        {project.contribution.pt.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </article>
</BaseLayout>
